# ==============================================================================
# CoastPulse Environment Configuration Profile: Local (Default Production)
# ==============================================================================
# Single-user or dedicated field-workstation deployment profile.
# Bound strictly to 127.0.0.1. SQLite or local PostgreSQL, high-security hashing.

ENVIRONMENT=local
PROJECT_NAME="CoastPulse - Coastal SAR Intelligence"
API_V1_STR=/api/v1
DEBUG=false

# --- Network Binding: Strictly Localhost ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# --- Security ---
SECRET_KEY=generate_with_python_secrets_token_hex_32_bytes_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_HASH_ROUNDS=12

# --- Database ---
# Local SQLite default or local PostgreSQL:
DATABASE_URL=sqlite+aiosqlite:///./coastpulse_dev.db

# --- Storage Paths ---
DATA_DIR=./data
PROCESSED_DIR=./data/processed

# --- Provider & AI Integrations ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
