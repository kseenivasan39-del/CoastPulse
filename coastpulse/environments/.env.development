# ==============================================================================
# CoastPulse Environment Configuration Profile: Development
# ==============================================================================
# Fast iteration profile with hot-reload, debug logs, local SQLite fallback,
# and relaxed rate limits. Strictly bound to localhost.

ENVIRONMENT=development
PROJECT_NAME="CoastPulse [Development]"
API_V1_STR=/api/v1
DEBUG=true

# --- Network Binding ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# --- Security ---
SECRET_KEY=dev_secret_key_minimum_32_characters_for_local_debugging_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_ROUNDS=4

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./coastpulse_dev.db

# --- Storage Paths ---
DATA_DIR=./data
PROCESSED_DIR=./data/processed

# --- Provider & AI Integrations (Optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
