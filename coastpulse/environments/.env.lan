# ==============================================================================
# CoastPulse Environment Configuration Profile: LAN (Local Area Network)
# ==============================================================================
# Multi-user lab or marine research vessel deployment profile.
# Bound to local network interface (e.g., 0.0.0.0 or 192.168.x.x) with
# subnet CORS restriction. Requires PostgreSQL + PostGIS.

ENVIRONMENT=lan
PROJECT_NAME="CoastPulse LAN Intelligence"
API_V1_STR=/api/v1
DEBUG=false

# --- Network Binding: Local Subnet Only ---
HOST=0.0.0.0
PORT=8000
# Replace with actual internal LAN workstation IP / domain:
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.1.100:3000","http://192.168.1.100:8000"]

# --- Security ---
SECRET_KEY=lan_secure_cluster_secret_key_minimum_32_chars_replace_now
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_HASH_ROUNDS=12

# --- Production Multi-User Database ---
DATABASE_URL=postgresql+asyncpg://coastpulse_user:coastpulse_secret@127.0.0.1:5432/coastpulse_db

# --- Distributed Job Queue ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Storage Paths ---
DATA_DIR=./data
PROCESSED_DIR=./data/processed

# --- Provider & AI Integrations ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
