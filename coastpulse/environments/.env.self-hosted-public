# ==============================================================================
# CoastPulse Environment Configuration Profile: Self-Hosted Public Cloud
# ==============================================================================
# Internet-facing deployment profile. MUST be placed behind an SSL reverse proxy
# (Nginx, Traefik, or Caddy) terminating TLS 1.3 with strict CORS, rate limiting,
# hardened password hashing, and encrypted credentials.

ENVIRONMENT=production
PROJECT_NAME="CoastPulse - Coastal SAR Intelligence"
API_V1_STR=/api/v1
DEBUG=false

# --- Network Binding: Loopback Behind Reverse Proxy Only ---
HOST=127.0.0.1
PORT=8000
# Strictly enumerate permitted public domain origins:
CORS_ORIGINS=["https://coastpulse.example.org","https://api.coastpulse.example.org"]

# --- Security: Cryptographically Hardened ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=MUST_BE_REPLACED_WITH_SECURE_RANDOM_HEX_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_HASH_ROUNDS=14

# --- Production Multi-User PostGIS Database ---
DATABASE_URL=postgresql+asyncpg://coastpulse_app:STRONG_POSTGRES_PASSWORD_HERE@127.0.0.1:5432/coastpulse_prod

# --- Distributed Job Queue ---
REDIS_URL=redis://:STRONG_REDIS_PASSWORD@127.0.0.1:6379/0

# --- Storage Quota & Limits ---
MAX_UPLOAD_SIZE_MB=500
DATA_DIR=/var/lib/coastpulse/data
PROCESSED_DIR=/var/lib/coastpulse/data/processed

# --- Provider & AI Integrations ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
