# CoastPulse Environment Configuration Reference
# Rename or copy to .env in coastpulse/ for local customisation.

# --- Core Application & Local Network Binding ---
ENVIRONMENT=production
PROJECT_NAME="CoastPulse - Coastal SAR Intelligence"
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000

# --- Security & JWT Settings ---
# In production, generate a secure random 256-bit secret key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=coastpulse-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Database Connection ---
# Production PostgreSQL + PostGIS (recommended for multi-user deployment):
# DATABASE_URL=postgresql+asyncpg://coastpulse_user:coastpulse_secure_password@127.0.0.1:5432/coastpulse_db

# Lightweight Local Development SQLite Fallback (default when unset):
DATABASE_URL=sqlite+aiosqlite:///./coastpulse_dev.db

# --- External EO & AI Credentials ---
# NASA Earthdata Login (ASF DAAC / CMR NISAR Search)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Google Gemini API Key (Evidence-Grounded Scientific Advisor)
GEMINI_API_KEY=

# --- Storage Paths ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
CACHE_DIR=data/cache
